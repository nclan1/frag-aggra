# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/fragrance_database?sslmode=disable
POSTGRES_PASSWORD=your_secure_password

# RabbitMQ
RABBITMQ_USER=frag
RABBITMQ_PASSWORD=your_secure_password

# Reddit API credentials
# Create an app at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_username
REDDIT_PASSWORD=your_password

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here

# Scraper settings
REDDIT_FETCH_LIMIT=25
# How often to poll Reddit in seconds (default 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300